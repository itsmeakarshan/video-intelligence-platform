.git
.gitignore
.DS_Store
*.md
*.log

# Python local environments and caches

backend/.venv
**/.venv
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache
.ipynb_checkpoints
*.sqlite3-journal

