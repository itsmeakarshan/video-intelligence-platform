frontend/node_modules
frontend/dist
frontend/.vite
node_modules

# Temporary local data
backend/temp_audio/*
backend/outputs/*
!backend/uploads/.gitkeep
!backend/temp_audio/.gitkeep
!backend/outputs/.gitkeep
