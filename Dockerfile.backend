# ========================================================
# Video Intelligence Platform - .NET Backend Dockerfile
# Multi-stage build for ASP.NET Core & Whisper Engine
# ========================================================

# Stage 1: Build .NET Backend
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY backend/VideoIntelligencePlatform.Backend.csproj backend/
RUN dotnet restore backend/VideoIntelligencePlatform.Backend.csproj

COPY backend/ backend/
RUN dotnet publish backend/VideoIntelligencePlatform.Backend.csproj -c Release -o /app/publish

# Stage 2: Runtime Environment
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

# Install system utilities, ffmpeg, python3, and yt-dlp for Whisper speech-to-text
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Whisper & audio requirements
COPY backend/ml/requirements.txt /app/backend/ml/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /app/backend/ml/requirements.txt \
    && rm -rf /root/.cache/pip

# Copy Whisper transcription scripts
COPY backend/ml /app/backend/ml

# Copy published ASP.NET Core backend
COPY --from=build /app/publish /app/backend

WORKDIR /app/backend

# Copy starter database & seed media assets (courses, thumbnails, banners, processed videos)
COPY backend/video_intelligence.db* /app/backend/
COPY backend/uploads /app/backend/uploads

# Runtime storage folders & ensure db volume seed exists
RUN mkdir -p uploads/thumbnails uploads/chat_media uploads/banners temp_audio outputs db \
    && if [ -f /app/backend/video_intelligence.db ]; then cp /app/backend/video_intelligence.db /app/backend/db/video_intelligence.db; fi

EXPOSE 8000
ENV PORT=8000
ENV ASPNETCORE_URLS=http://+:8000

ENTRYPOINT ["dotnet", "VideoIntelligencePlatform.Backend.dll"]
