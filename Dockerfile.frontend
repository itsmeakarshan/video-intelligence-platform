# ========================================================
# Video Intelligence Platform - React Frontend Dockerfile
# Multi-stage build with Node 22 & Nginx Alpine
# ========================================================

# Stage 1: Build React Application
FROM node:22-alpine AS build-stage

WORKDIR /app/frontend

# Install libc6-compat for native compatibility with Tailwind v4 & Vite
RUN apk add --no-cache libc6-compat

# Optional build-time argument for backend API URL in AWS/Cloud environments
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

COPY frontend/package*.json ./
RUN npm ci || npm install

COPY frontend ./
RUN npm run build

# Stage 2: Production Nginx Server
FROM nginx:alpine AS production-stage

COPY --from=build-stage /app/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Health check for AWS ECS / container health monitoring
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -q -O /dev/null http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
